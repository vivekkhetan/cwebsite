# Copy this file to .env.local for local development with `vercel dev`,
# and set the same values in your Vercel project's Environment Variables
# for production (Project Settings → Environment Variables).

# Resend (https://resend.com) API key used to send "Talk to Us" form emails.
RESEND_API_KEY=

# Email address that receives new lead notifications.
COMPANY_NOTIFICATION_EMAIL=vivek.khetan@cachemere.ai

# "From" address for outgoing emails. Must be on a domain verified in
# Resend, or use the shared onboarding@resend.dev address while testing
# (still delivers, but "from" will show Resend's domain instead of yours).
CONTACT_FROM_EMAIL=onboarding@resend.dev
