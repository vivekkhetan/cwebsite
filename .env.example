# Copy this file to .env.local for local development with `vercel dev`,
# and set the same values in your Vercel project's Environment Variables
# for production (Project Settings → Environment Variables).
#
# These come from registering an app in the Microsoft Entra admin center
# and granting it Mail.Send permission — see README.md for the full setup.
# No mailbox password is involved anywhere.

MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# The mailbox the app sends mail as (must match the mailbox the
# Mail.Send permission was scoped to, if you restricted it).
MS_SENDER_EMAIL=info@cachemere.ai

# Where new lead notifications land. Defaults to MS_SENDER_EMAIL if left
# blank — set this only if leads should go somewhere else.
COMPANY_NOTIFICATION_EMAIL=vivek.khetan@cachemere.ai
