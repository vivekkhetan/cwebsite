# Copy this file to .env.local for local development with `vercel dev`,
# and set the same values in your Vercel project's Environment Variables
# for production (Project Settings → Environment Variables).

# The mailbox the "Talk to Us" form authenticates as and sends through,
# via smtp-mail.outlook.com. This is that account's password (or an app
# password, if the account has MFA enabled).
SMTP_USER=info@cachemere.ai
SMTP_PASSWORD=

# Where new lead notifications land. Defaults to SMTP_USER (same inbox
# that's sending) if left blank — set this only if leads should go
# somewhere else.
COMPANY_NOTIFICATION_EMAIL=vivek.khetan@cachemere.ai
