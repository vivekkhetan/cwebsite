# Copy this file to .env.local for local development with `vercel dev`,
# and set the same values in your Vercel project's Environment Variables
# for production (Project Settings → Environment Variables).

# The Gmail / Google Workspace address the "Talk to Us" form sends through.
# Requires an App Password, not the account's normal login password —
# see README.md for how to generate one.
GOOGLE_SMTP_USER=vivek.khetan@cachemere.ai
GOOGLE_SMTP_APP_PASSWORD=

# Where new lead notifications land. Defaults to GOOGLE_SMTP_USER (same
# inbox that's sending) if left blank — set this only if leads should go
# somewhere else.
COMPANY_NOTIFICATION_EMAIL=
